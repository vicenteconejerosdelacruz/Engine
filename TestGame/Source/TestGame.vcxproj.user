    <LocalDebuggerCommandArgumentsHistory>--generate-dds|</LocalDebuggerCommandArgumentsHistory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Editor_Release|x64'">
